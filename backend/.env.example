DATABASE_URL=sqlite+aiosqlite:///./unification.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Public URL of this server; webhook URLs shown when connecting WhatsApp use it (e.g. an ngrok URL in development)
PUBLIC_BASE_URL=http://localhost:8000
# META_GRAPH_URL=https://graph.facebook.com/v20.0

DEMO_MODE=true
DEMO_EMAIL=demo@unification.app
DEMO_PASSWORD=demo12345
DEMO_REPLY_DELAY_SECONDS=3

# AI: "fake" works offline; set "openai" + key for real answers (OpenAI-compatible endpoint)
LLM_PROVIDER=fake
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key
# LLM_MODEL=gemini-3.6-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
